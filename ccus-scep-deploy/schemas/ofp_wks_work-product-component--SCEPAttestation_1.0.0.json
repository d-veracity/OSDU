      "legal": {"type": "object", "properties": {
        "legaltags": {"type": "array", "items": {"type": "string"}},
        "otherRelevantDataCountries": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string"}},
        "required": ["legaltags", "otherRelevantDataCountries"]},
      "tags": {"type": "object", "additionalProperties": {"type": "string"}},
      "createTime": {"type": "string", "format": "date-time"}, "createUser": {"type": "string"},
      "modifyTime": {"type": "string", "format": "date-time"}, "modifyUser": {"type": "string"},
      "data": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "activityType": {"type": "string"},
          "attestationId": {"type": "string"},
          "scepId": {"type": "string"},
          "scepSnapshotId": {"type": "string"},
          "scepSnapshotHash": {"type": "string"},
          "attestationStatus": {"type": "string", "enum": ["issued", "suspended", "revoked"]},
          "confidenceScore": {"type": "number"},
          "verifiableCredential": {
            "type": "object", "additionalProperties": true,
            "properties": {
              "type": {"type": "string"},
              "issuer": {"type": "string"},
              "subject": {"type": "string"},
              "issuanceDate": {"type": "string", "format": "date-time"},
              "proofType": {"type": "string"},
              "proofValue": {"type": "string"},
              "credentialStatus": {"type": "string"}
            }
          },
          "attestationRef": {"type": "string"},
          "issuedBy": {"type": "string"},
          "issuedAt": {"type": "string", "format": "date-time"},
          "reason": {"type": "string"}
        }
      }
