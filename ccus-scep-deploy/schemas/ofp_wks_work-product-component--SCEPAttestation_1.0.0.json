    "x-osdu-schema-source": "ofp:wks:work-product-component--SCEPAttestation:1.0.0",
    "x-dve-domain": "scep",
    "x-dve-note": "dVeracity bridge: binds a VerifiableCredential to a certified SCEP snapshot by SHA256 hash (dVeracity types VerifiableCredential, AttestationRef, ConfidenceScore, SHA256Hash).",
    "title": "SCEPAttestation",
    "description": "dVeracity attestation over a SCEP certification, grounding the trust layer in a verifiable credential bound to the evidence-pack hash.",
    "type": "object",
    "properties": {
      "id": {"type": "string"}, "kind": {"type": "string"}, "version": {"type": "integer"},
      "acl": {"type": "object", "properties": {
